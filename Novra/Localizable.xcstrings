    "Apps may open a little slower the first time while they rebuild these. Settings, documents and sign-ins stay.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi mungkin sedikit lebih lambat saat pertama dibuka karena membangun ulang cache. Pengaturan, dokumen dan login tetap aman."
          }
        }
      }
    },
    "Apps open fresh instead of restoring old windows. Unfinished downloads would need downloading again.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi dibuka bersih tanpa memulihkan jendela lama. Unduhan yang belum selesai perlu diunduh ulang."
          }
        }
      }
    },
    "Apps that are open will be quit first.": {
