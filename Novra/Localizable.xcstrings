    "%@ more sits in images no container uses and in volumes. Volumes can hold your databases, so Novra leaves both alone. Remove them in Docker Desktop if you don't need them.": {
      "extractionState": "stale",
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagi ada di image yang tidak dipakai container dan di volume. Volume bisa berisi database, jadi Novra tidak menyentuh keduanya. Hapus lewat Docker Desktop kalau memang tidak diperlukan."
          }
        }
      }
    },
    "%@ more sits in stopped containers, images no container uses and volumes. These can hold your databases, so Novra leaves them alone. Remove them in Docker Desktop if you don't need them.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagi ada di container yang berhenti, image yang tidak dipakai container, dan volume. Semuanya bisa berisi database Anda, jadi Novra membiarkannya. Hapus lewat Docker Desktop jika memang tidak diperlukan."
          }
        }
      }
    },
