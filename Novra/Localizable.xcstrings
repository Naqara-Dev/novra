    "Warn below": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatkan di bawah"
          }
        }
      }
    },
    "Warn me when the disk is almost full": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatkan saat disk hampir penuh"
          }
        }
      }
    },
    "Welcome to Novra": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang di Novra"
          }
        }
      }
    },
    "What happens if you clean this": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang terjadi jika dibersihkan"
          }
        }
      }
    },
    "What's new": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang baru"
          }
        }
      }
    },
    "When removing": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menghapus"
          }
        }
      }
    },
    "Working…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memproses…"
          }
        }
      }
    },
    "Worth a Look": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layak Dicek"
          }
        }
      }
    },
    "Xcode builds, simulator caches and package-manager downloads.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Build Xcode, cache simulator dan unduhan package manager."
          }
        }
      }
    },
    "Xcode simulators for runtimes you no longer have.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator Xcode untuk runtime yang sudah tidak ada."
          }
        }
      }
    },
    "You can close this; the tool keeps running.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela ini bisa ditutup; tool tetap berjalan."
          }
        }
      }
    },
    "You have version %@. Download the new version from GitHub?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memakai versi %@. Unduh versi baru dari GitHub?"
          }
        }
      }
    },
    "You have version %@. Novra downloads it and restarts when you're ready, keeping its permissions.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memakai versi %@. Novra mengunduhnya lalu memulai ulang saat kamu siap, tanpa perlu memberi izin lagi."
          }
        }
      }
    },
    "You kept everything.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menyimpan semuanya."
          }
        }
      }
    },
    "You know what happens next": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tahu apa yang terjadi"
          }
        }
      }
    },
    "You see everything first": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda melihat semuanya dulu"
          }
        }
      }
    },
    "You'll pick a drive. Novra removes ._ files, .DS_Store and .TemporaryItems on it. The drive's Trash and Spotlight index are left alone.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan memilih drive. Novra menghapus file ._, .DS_Store dan .TemporaryItems di sana. Tong Sampah dan indeks Spotlight drive tidak disentuh."
          }
        }
      }
    },
    "You're up to date (version %@).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Novra sudah versi terbaru (%@)."
          }
        }
      }
    },
    "Your Mac is almost full": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda hampir penuh"
          }
        }
      }
    },
    "Your Mac is spotless": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda sudah bersih"
          }
        }
      }
    },
    "Your disk looks healthy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk Anda sehat"
          }
        }
      }
    },
    "Your files are never uploaded. No analytics, no tracking. The only connection is an optional update check.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File Anda tidak pernah diunggah. Tanpa analitik, tanpa pelacakan. Satu-satunya koneksi adalah cek pembaruan yang bisa dimatikan."
          }
        }
      }
    },
    "Your photos look tidy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto Anda sudah rapi"
          }
        }
      }
    },
    "Your source code stays. Everything here comes back with npm install, pod install or a build. Deleting permanently frees the space right away.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode sumber tetap aman. Semua ini kembali dengan npm install, pod install atau build. Hapus permanen langsung membebaskan ruang."
          }
        }
      }
    },
    "Your virtual devices. Each one can take several GB.": {
      "extractionState": "stale",
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat virtual Anda. Masing-masing bisa beberapa GB."
          }
        }
      }
    },
    "and %lld more": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dan %lld lainnya"
          }
        }
      }
    },
    "and %lld more groups. Use Swipe to Clean or Select extras.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dan %lld kelompok lainnya. Pakai Geser untuk Bersihkan atau Pilih yang berlebih."
          }
        }
      }
    },
