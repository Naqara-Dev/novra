          }
        }
      }
    },
    "macOS keeps a log of every file you've ever downloaded. Wipe it.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mencatat setiap file yang pernah Anda unduh. Hapus catatannya."
          }
        }
      }
    },
    "macOS's own daily, weekly and monthly housekeeping, run now.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perawatan harian, mingguan dan bulanan bawaan macOS, dijalankan sekarang."
          }
        }
      }
    },
