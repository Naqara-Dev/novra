    "Update available": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan tersedia"
          }
        }
      }
    },
    "Update didn't finish": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan belum selesai"
          }
        }
      }
    },
    "Updates live. macOS uses spare memory as cache, so “free” is usually small, and that's fine.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbarui langsung. macOS memakai memori kosong sebagai cache, jadi “kosong” biasanya kecil, dan itu normal."
          }
        }
      }
    },
    "Used by %@": {
      "localizations": {
        "id": {
          "stringUnit": {
